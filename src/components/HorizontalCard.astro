---
const { title, img, desc, url, badge, doi, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
const doi_url = doi ? `https://doi.org/${doi}` : undefined;
---

<!--
  The whole card is clickable via a "stretched link" on the title (the
  after:absolute after:inset-0 pseudo-element covers the card). Secondary
  links (DOI badge, tags) sit above it with relative z-10, which avoids
  nesting <a> elements, which is invalid HTML.
-->
<div
  class="relative rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <div class="hero-content flex-col md:flex-row">
    {
      img && (
        <Image
          src={img}
          width={750}
          height={422}
          format="webp"
          alt={title}
          class="max-w-full md:max-w-[13rem] rounded-lg"
        />
      )
    }
    <div class="grow w-full">
      <h1 class="text-xl font-bold">
        <a
          href={url}
          target={target}
          class="after:absolute after:inset-0 after:content-['']"
        >
          {title}
        </a>
        {
          badge &&
            (doi_url ? (
              <a
                href={doi_url}
                target="_blank"
                rel="noopener"
                title={`DOI: ${doi}`}
                class="relative z-10 badge badge-secondary mx-2 hover:badge-outline"
              >
                {badge}
              </a>
            ) : (
              <div class="badge badge-secondary mx-2">{badge}</div>
            ))
        }
      </h1>
      <p class="py-1 text-1xl">{desc}</p>
      <div class="card-actions justify-end items-center">
        {
          doi_url && (
            <a
              href={doi_url}
              target="_blank"
              rel="noopener"
              class="relative z-10 text-sm opacity-70 hover:opacity-100 hover:underline"
            >
              doi:{doi}
            </a>
          )
        }
        {
          tags &&
            tags.map((tag) => (
              <a href={`${tag_url}/${tag}`} class="relative z-10 badge badge-outline">
                {tag}
              </a>
            ))
        }
      </div>
    </div>
  </div>
</div>
